# Cloudflare Pages response headers
# 3D assets never change in place (rename the file to update), so cache them hard.
/models/*
  Cache-Control: public, max-age=31536000, immutable
/hdri/*
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache

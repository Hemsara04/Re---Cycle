{
  // Cloudflare Workers (static assets only). The site is a static Next.js export in ./out,
  // so `npm run build` must run before `wrangler deploy` (set as the Build command in Cloudflare).
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers & Pages → your project).
  "name": "re-cycle",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    // /dashboard → dashboard.html, unknown URLs → 404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
